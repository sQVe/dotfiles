{
  "profiles": {
    "default": {
      "model": "claude-bridge/claude-opus-5-5"
    },
    "scout": {
      "model": "openai/gpt-6.1-sol",
      "thinking": "medium",
      "route": {
        "classifier": "typesafe/jev-latest",
        "question": "How wide is this scout brief?",
        "labels": {
          "narrow": {
            "criterion": "A question answered by reading the repository or running local commands: where something is defined, which files use it, what a file, config, or command says, how a code path flows, or what a module does. It may span many files, but it asks for facts, not a recommendation.",
            "model": "claude-bridge/claude-haiku-5-5",
            "thinking": "low"
          },
          "wide": {
            "criterion": "A brief that needs judgment: an unknown root cause, a reproduction, research on the web, a review or audit, or a question that asks for a recommendation.",
            "model": "openai/gpt-6.1-sol"
          }
        }
      }
    },
    "reviewer": {
      "model": "openai/gpt-6.1-sol"
    },
    "checker": {
      "model": "claude-bridge/claude-sonnet-5-5"
    },
    "qa": {
      "model": "openai/gpt-6.1-terra"
    },
    "browser": {
      "model": "claude-bridge/claude-haiku-5-5",
      "thinking": "low"
    },
    "worker": {
      "model": "claude-bridge/claude-opus-5-5",
      "thinking": "medium",
      "route": {
        "classifier": "typesafe/jev-latest",
        "question": "How much design does this worker brief leave open?",
        "labels": {
          "contained": {
            "criterion": "The brief names what to change and how: a rename, a config or text edit, a fix whose cause is already known, or a change that copies an existing pattern in the repository. Any tests follow existing tests closely.",
            "model": "openai/gpt-6-astra",
            "thinking": "low"
          },
          "involved": {
            "criterion": "The brief leaves choices to the worker: an unknown root cause, a change across several modules or a shared interface, new tests to design, state, concurrency, or data migration, or acceptance criteria that do not say how to meet them.",
            "model": "claude-bridge/claude-opus-5-5",
            "thinking": "medium"
          }
        }
      }
    }
  },
  "tracker": {
    "agentTeam": "AI",
