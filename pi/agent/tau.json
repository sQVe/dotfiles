{
  "profiles": {
    "default": {
      "model": "claude-bridge/claude-opus-5-5"
    },
    "scout": {
      "model": "openai/gpt-6.1-sol",
      "route": {
        "classifier": "typesafe/jev-latest",
        "question": "How wide is this scout brief?",
        "labels": {
          "narrow": {
            "criterion": "A question answered by reading the repository or running local commands: where something is defined, which files use it, what a file, config, or command says, how a code path flows, or what a module does. It may span many files, but it asks for facts, not a recommendation.",
            "model": "claude-bridge/claude-haiku-5-5"
          },
          "wide": {
            "criterion": "A brief that needs judgment: an unknown root cause, a reproduction, research on the web, a review or audit, or a question that asks for a recommendation.",
            "model": "openai/gpt-6.1-sol"
          }
        }
      }
    },
    "reviewer": {
      "model": "openai/gpt-6.1-sol"
    },
    "qa": {
      "model": "openai/gpt-6.1-terra"
    },
    "browser": {
      "model": "claude-bridge/claude-haiku-5-5"
    },
    "worker": {
      "model": "claude-bridge/claude-opus-5-5",
      "route": {
        "classifier": "typesafe/jev-latest",
        "question": "How hard is this implementation task?",
        "labels": {
          "routine": {
            "criterion": "A change whose acceptance criteria say what to build, even across several files: a bug fix with a known cause, new or updated tests, a rename or move, a config or docs change, or a feature that follows an existing pattern.",
            "model": "claude-bridge/claude-haiku-5-5"
          },
          "hard": {
            "criterion": "A change that needs design or diagnosis: concurrency, native code, a new design across modules, a bug with an unknown cause, or an unclear specification.",
            "model": "claude-bridge/claude-opus-5-5"
          }
        }
      }
    }
  },
  "tracker": {
    "agentTeam": "AI",
    "repositories": {
      "sQVe/tau": {
        "team": "ME",
        "project": "Tau"
      },
      "sQVe/mergit": {
        "team": "ME",
        "project": "Mergit"
      },
      "sQVe/koja": {
        "team": "ME",
        "project": "Koja"
      },
      "hups-co/platform": {
        "team": "TMS"
      },
      "sQVe/tikk": {
        "team": "ME",
        "project": "Tikk"
      },
      "sQVe/mutation": {
        "team": "ME",
        "project": "Mutation"
      }
    }
  },
  "fullCheck": {
    "repositories": {
      "sQVe/tau": {
        "argv": ["pnpm", "check"]
      },
      "sQVe/mergit": {
        "argv": ["bun", "run", "--bun", "check"]
      },
      "sQVe/koja": {
        "argv": ["bun", "run", "--bun", "check"]
      },
      "hups-co/platform": {
        "argv": [
          "sh",
          "-c",
          "pnpm run lint:ci && pnpm run format:ci && pnpm run lint:rules && pnpm run lint:env && pnpm run lint:exports && pnpm run lint:event-catalog && pnpm run translations:ci && pnpm run typecheck && pnpm run test:ci"
        ]
      }
    }
  },
  "browser": {
    "loginCommand": "google-chrome-stable --profile-directory=\"Agent profile\""
  },
  "reviews": {
    "repositories": {
      "sQVe/koja": {
        "bots": [
          {
            "login": "chatgpt-codex-connector",
            "comment": "@codex review"
